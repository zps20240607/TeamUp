# 复制本文件为 .env 后填写真实值：
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会进入版本库。
# docker-compose.yml / docker-compose.local.yml 使用 ${VAR:?提示} 做非空校验：
# 变量缺失时 compose 会直接报错并打印提示，避免用空值或弱口令把服务启动起来。

# --- MySQL root 口令 ---
# 注意：MySQL 官方镜像只在【数据卷首次初始化】时应用该值。
# 若数据卷 team_mysql_data 已存在，改这里不会改掉库里的实际口令，
# 需要在容器内执行：ALTER USER 'root'@'%' IDENTIFIED BY '<新口令>'; FLUSH PRIVILEGES;
MYSQL_ROOT_PASSWORD=

# --- Redis 口令 ---
REDIS_PASSWORD=

# --- JWT 签名密钥 ---
# 生成方式：openssl rand -hex 32
JWT_SECRET=

# --- 大模型 API Key（OpenAI 兼容接口）---
LANGCHAIN_API_KEY=
